{
  "name": "@tokensapi/dsh-progressive-tools",
  "version": "0.2.3",
  "description": "Progressive tool discovery with native execution and optional stable proxy transport",
  "tokenscowork": {
    "displayName": {
      "zh-CN": "渐进式工具",
      "en-US": "Progressive Tools"
    },
    "summary": {
      "zh-CN": "只让高频工具常驻模型上下文，其余工具按需搜索并通过原有 DSH 安全执行链分发。",
      "en-US": "Keep frequently used tools in context, discover others on demand, and execute them through the standard DSH safety pipeline."
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "docs/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:session": "node scripts/audit-session.mjs",
    "test:runtime": "node --import ./scripts/runtime-loader.mjs scripts/native-smoke.mjs",
    "eval:offline": "node scripts/evaluate.mjs",
    "eval:live": "node scripts/evaluate.mjs --live",
    "check": "node --check scripts/audit-session.mjs && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run publint",
    "publint": "publint",
    "prepack": "pnpm run check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokensAPI/tokens_DshProgressiveTools_code.git"
  },
  "bugs": {
    "url": "https://github.com/TokensAPI/tokens_DshProgressiveTools_code/issues"
  },
  "homepage": "https://github.com/TokensAPI/tokens_DshProgressiveTools_code#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "tokenscowork",
    "tools",
    "progressive-disclosure",
    "token-optimization"
  ],
  "author": "TokensAPI contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.tokensapi.ai/"
  },
  "dsh": {
    "engine": "0.1.0-rc.8 || 0.1.3-alpha.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8 || 0.1.3-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxlint": "^1.76.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  }
}
